# You can also use any non-zero value if you'd like to have a border
for_window [class=".*"] border pixel 0

# smart_borders on
default_border none
default_floating_border none
smart_gaps on
border_radius 13
gaps outer 5
gaps inner 10

# class                  border                        background             text                indicator              child_border
client.focused           #ebdbb2           #458588           #fbf1c7      #458588           #ebdbb2
client.focused_inactive  #7c6f64  #665c54  #bdae93  #665c54  #7c6f64
client.unfocused         #3c3836         #282828         #bdae93     #282828         #3c3836
client.urgent            #cc241d            #cc241d            #fbf1c7  #cc241d            #cc241d

workspace $ws1 output DP-1-0.3
workspace $ws2 output DP-1-0.1
workspace $ws10 output DP-1-0.1

# assign [class="kitty"] 1
# assign [class="firefox"] 2
# assign [class="Slack"] 3

for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman"] floating enable, resize set 700px 400px, move position center
for_window [class="Nautilus"] floating enable
# for_window [class="kitty"] smart_gaps on
# for_window [class="kitty"] smart_borders on

for_window [class="avizo.*"] floating border pixel 0
for_window [class="avizo.*"] border pixel 0

# autostart
exec --no-startup-id dunst
exec --no-startup-id picom --config ~/.config/picom/picom.conf -b
exec --no-startup-id ~/.config/scripts/startup.sh

exec_always --no-startup-id autorandr -c --default horizontal
exec --no-startup-id redshift -o

# avizo can be a bitch on multiple monitors
exec --no-startup-id avizo-service

exec --no-startup-id "i3-msg 'workspace $ws10; exec spotify; workspace $ws2; exec $term; workspace $ws9; exec flatpak run com.slack.Slack; workspace $ws1; exec firefox;'"

exec --no-startup-id /usr/libexec/gsd-xsettings
exec --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'

# exec --no-startup-id xset s off -dpms

for_window [class="kitty"] floating enable, resize set 800px 500px, move position center
for_window [class="taskman"] floating enable, resize set 900px 600px, move position center

for_window [class="Spotify"] move to workspace $ws10
for_window [class="Slack"] move to workspace $ws9
